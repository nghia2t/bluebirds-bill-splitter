# Copy to .env and fill in. .env is gitignored.
# Nuxt picks up NUXT_* vars via runtimeConfig.

# Postgres connection string. For local dev:
#   docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16
#   NUXT_DATABASE_URL="postgres://postgres:postgres@localhost:5432/bluebirds_bill_splitter"
# For Neon:
#   NUXT_DATABASE_URL="postgres://<user>:<pwd>@<host>/<db>?sslmode=require"
NUXT_DATABASE_URL=""

# Google OAuth — create credentials at https://console.cloud.google.com
# Authorized redirect URI: <NUXT_PUBLIC_BASE_URL>/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=""
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=""

# Session cookie encryption key — must be at least 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=""

# Public base URL — used in OAuth redirect URI and absolute links.
NUXT_PUBLIC_BASE_URL="http://localhost:3000"
